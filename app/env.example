# Databricks Configuration
DATABRICKS_HOST=https://e2-demo-west.cloud.databricks.com/
DATABRICKS_TOKEN=your_token_here

# SQL Warehouse ID (optional - will auto-detect if not set)
DATABRICKS_WAREHOUSE_ID=

# Application Settings
APP_ENV=dev
CATALOG_NAME=shared
SCHEMA_NAME=fashion_recommendations
VOLUME_PATH=/Volumes/shared/fashion_recommendations/data

