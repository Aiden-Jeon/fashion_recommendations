# Application Environment
APP_ENV=dev

# Databricks Catalog Configuration
CATALOG_NAME=jongseob_demo
SCHEMA_NAME=fashion_recommendations
VOLUME_PATH=/Volumes/jongseob_demo/fashion_recommendations/data

# Databricks Authentication (for local development only)
# Get your personal access token from: https://<your-workspace>.cloud.databricks.com/#setting/account
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token-here

# Optional: Specify a specific SQL Warehouse ID
# If not set, the app will automatically use the first available warehouse
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id

